# Copia in .env per sviluppo locale con `netlify dev`
# Su Netlify: Site settings → Environment variables

# Segreto per firmare i JWT utente (genera una stringa casuale lunga)
JWT_SECRET=

# Token CardTrader (mai nel frontend) — accetta CARDTRADER_API_TOKEN o CARDTRADER_API_KEY
CARDTRADER_API_TOKEN=

# API Key Pokémon TCG (mai nel frontend)
POKEMON_TCG_API_KEY=

# Parametri proxy Scryfall MTG (opzionali)
MTG_TIMEOUT_MS=12000
MTG_RETRY_ATTEMPTS=1
MTG_RETRY_DELAY_MS=180
MTG_CACHE_TTL_MS=90000
MTG_CACHE_MAX_ENTRIES=300

# Batch giornaliero MTG (cron esterno, es. GitHub Actions)
MTG_BATCH_SECRET=
MTG_BATCH_TIMEOUT_MS=12000
MTG_BATCH_RETRY_ATTEMPTS=2
MTG_BATCH_RETRY_DELAY_MS=200
MTG_BATCH_DELAY_MS=80
